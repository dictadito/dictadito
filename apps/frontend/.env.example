# Variables del frontend. Valores de ejemplo: nunca pongas claves reales acá.
# Ojo: todo lo que empieza con VITE_ termina en el navegador, a la vista de cualquiera.

# Dirección del backend. En la compu, /api (Vite lo redirige al backend local).
VITE_API_URL=/api

# A dónde redirige Vite el /api cuando trabajás en la compu.
BACKEND_URL=http://localhost:3000
