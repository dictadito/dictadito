# Variables del backend. Valores de ejemplo: nunca pongas claves reales acá.
# En tu compu no hace falta ninguna: si no están, se usan los valores de abajo.

# Puerto donde escucha el backend.
PORT=3000

# local, staging o produccion.
AMBIENTE=local

# Versión que muestra /version. En staging y producción la pone el deploy.
APP_VERSION=dev

# Commit que muestra /version. En staging y producción lo pone el deploy.
# GIT_COMMIT=abc1234
