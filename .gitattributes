# Todo el texto con finales de línea LF, también en Windows.
* text=auto eol=lf

# Scripts de Windows con CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Archivo que arma npm solo: GitHub lo muestra plegado en los pull requests.
package-lock.json linguist-generated=true
